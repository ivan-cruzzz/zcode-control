# ============================================================
# ZCODE Bridge — локальный конфиг.
# Скопируйте файл:  cp .env.example .env   и заполните значения.
# Файл .env исключён из git (.gitignore) — секреты не попадут в репозиторий.
# ============================================================

# Токен бота от @BotFather. ХРАНИТЕ ТОЛЬКО ЗДЕСЬ, на своём компьютере.
BOT_TOKEN=

# (рекомендуется) Белый список Telegram user id через запятую.
# Свой id можно узнать у @userinfobot. Пусто — пройдёт любой,
# чья подпись initData валидна.
ALLOWED_USER_IDS=

# Порт локального моста
PORT=8787

# Максимальный возраст initData (секунды). 86400 = сутки.
MAX_AUTH_AGE=86400

# Разрешённые Origin через запятую (CORS для Mini App и WebSocket).
# Добавьте свой домен/туннель, если мини-апп хостится не на GitHub Pages.
ALLOWED_ORIGINS=https://ivan-cruzzz.github.io,http://localhost:3000,http://localhost:5173,http://localhost:8080

# Лимит запросов с одного IP в минуту
RATE_LIMIT=120

# Путь к базе ZCODE, если нестандартный
# ZCODE_DB=/путь/к/db.sqlite
